<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <!-- Home icon -->
    <view wx:if="{{item.iconType === 'home'}}" class="tab-icon">
      <svg viewBox="0 0 24 24" width="48rpx" height="48rpx">
        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" fill="none" stroke="{{selected === index ? '#b85b3d' : '#a39c8f'}}" stroke-width="{{selected === index ? 2.5 : 2}}" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M9 22V12h6v10" fill="none" stroke="{{selected === index ? '#b85b3d' : '#a39c8f'}}" stroke-width="{{selected === index ? 2.5 : 2}}" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </view>
    <!-- Book icon -->
    <view wx:elif="{{item.iconType === 'book'}}" class="tab-icon">
      <svg viewBox="0 0 24 24" width="48rpx" height="48rpx">
        <path d="M4 19.5A2.5 2.5 0 016.5 17H20" fill="none" stroke="{{selected === index ? '#b85b3d' : '#a39c8f'}}" stroke-width="{{selected === index ? 2.5 : 2}}" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z" fill="none" stroke="{{selected === index ? '#b85b3d' : '#a39c8f'}}" stroke-width="{{selected === index ? 2.5 : 2}}" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </view>
    <!-- User icon -->
    <view wx:elif="{{item.iconType === 'user'}}" class="tab-icon">
      <svg viewBox="0 0 24 24" width="48rpx" height="48rpx">
        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" fill="none" stroke="{{selected === index ? '#b85b3d' : '#a39c8f'}}" stroke-width="{{selected === index ? 2.5 : 2}}" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="12" cy="7" r="4" fill="none" stroke="{{selected === index ? '#b85b3d' : '#a39c8f'}}" stroke-width="{{selected === index ? 2.5 : 2}}" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
