.tab-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 120rpx;
  padding: 0 32rpx;
  background-color: #fdfbf6;
  border-top: 2rpx solid #e8e1cf;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 20rpx rgba(0, 0, 0, 0.02);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  gap: 4rpx;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #a39c8f;
}

.tab-item.active .tab-text {
  color: #b85b3d;
}
