page {
  --color-primary: #b85b3d;
  --color-primary-light: #fcf0e8;
  --color-bg: #f4f0e6;
  --color-card: #fdfbf6;
  --color-text: #362f2d;
  --color-text-secondary: #7a7267;
  --color-text-muted: #a39c8f;
  --color-border: #e8e1cf;
  --color-green: #6b8e5c;
  --color-green-light: #eef1eb;
  --color-green-border: #d2decb;
  --color-orange: #d48c6a;
  --color-orange-light: #fcf0e8;
  --color-orange-border: #eebd9c;
  --color-brown: #8d7c62;
  --color-brown-light: #f2ebdf;
  --color-blue: #6a8ea3;
  --color-blue-light: #e8f0f3;
  --color-white: #ffffff;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  --radius-full: 999rpx;
  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  --shadow-md: 0 8rpx 28rpx rgba(184, 91, 61, 0.15);
  --padding-page: 40rpx;

  background-color: var(--color-bg);
  background-image: linear-gradient(rgba(232, 225, 207, 0.7) 1px, transparent 1px);
  background-size: 100% 80rpx;
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  line-height: 1.6;
  font-size: 28rpx;
  box-sizing: border-box;
}

.container {
  padding: var(--padding-page);
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.btn-primary {
  background-color: var(--color-primary);
  color: #fff;
  border: none;
  border-radius: var(--radius-lg);
  padding: 28rpx 0;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  width: 100%;
  box-shadow: 0 8rpx 28rpx rgba(184, 91, 61, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-primary.disabled {
  opacity: 0.7;
}

.card {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  border: 2rpx solid var(--color-border);
  padding: 40rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  border-bottom: 2rpx solid var(--color-border);
  background-color: rgba(244, 240, 230, 0.9);
  backdrop-filter: blur(20px);
  position: sticky;
  top: 0;
  z-index: 100;
}

.page-header .back-btn {
  padding: 16rpx;
  margin-left: -16rpx;
  color: var(--color-text);
}

.page-header .title {
  font-weight: 700;
  font-size: 34rpx;
  color: var(--color-text);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.page-header .placeholder {
  width: 80rpx;
}

.chip {
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: 2rpx solid var(--color-border);
  background-color: var(--color-bg);
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.chip.active {
  background-color: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
  box-shadow: 0 4rpx 16rpx rgba(184, 91, 61, 0.3);
}
