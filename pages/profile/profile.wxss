.page {
  min-height: 100vh;
  background-color: #f4f0e6;
}

/* ── Header ── */
.header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(244, 240, 230, 0.9);
  backdrop-filter: blur(12px);
  padding: 0 40rpx;
}

.header-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
}

.page-title {
  font-weight: 700;
  color: #362f2d;
  font-size: 42rpx;
}

/* ── Body ── */
.body {
  padding: 32rpx 40rpx;
  padding-bottom: 200rpx;
}

/* ── User Info Card ── */
.user-card {
  background: #fdfbf6;
  padding: 40rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  border: 2rpx solid #e8e1cf;
  position: relative;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.user-card-blur {
  position: absolute;
  right: -32rpx;
  top: -32rpx;
  width: 192rpx;
  height: 192rpx;
  background: rgba(184, 91, 61, 0.05);
  border-radius: 50%;
  filter: blur(40rpx);
}

.user-info {
  display: flex;
  align-items: center;
  gap: 32rpx;
  position: relative;
  z-index: 1;
}

.avatar-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid #f4f0e6;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-weight: 700;
  color: #362f2d;
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.user-subtitle-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.star-icon {
  font-size: 24rpx;
  color: #d48c6a;
}

.user-subtitle {
  font-size: 24rpx;
  color: #a39c8f;
}

.chevron {
  font-size: 48rpx;
  color: #d0cdb7;
  font-weight: 300;
}

/* ── Stats Row ── */
.stats-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  flex: 1;
  background: #fdfbf6;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  border: 2rpx solid #e8e1cf;
  padding: 36rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-card:active {
  opacity: 0.85;
}

.stat-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.stat-icon-green {
  color: #6b8e5c;
}

.stat-icon-primary {
  color: #b85b3d;
}

.stat-count {
  font-weight: 700;
  font-size: 42rpx;
  color: #362f2d;
}

.stat-label {
  font-size: 24rpx;
  color: #7a7267;
}

/* ── Menu Card ── */
.menu-card {
  background: #fdfbf6;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  border: 2rpx solid #e8e1cf;
  overflow: hidden;
}

.menu-item {
  width: 100%;
  padding: 32rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-bottom: 2rpx solid #f4f0e6;
}

.menu-item.last {
  border-bottom: none;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.icon-green {
  background: #eef1eb;
  color: #6b8e5c;
}

.icon-grey {
  background: #f4f0e6;
  color: #a39c8f;
}

.icon-orange {
  background: #f9e9e3;
  color: #b85b3d;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #362f2d;
}

.menu-version {
  font-size: 24rpx;
  color: #a39c8f;
  margin-right: 8rpx;
}

.menu-chevron {
  font-size: 40rpx;
  color: #d0cdb7;
  font-weight: 300;
}
