.page {
  min-height: 100vh;
  background-color: var(--color-bg);
}

/* ===== Header ===== */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #f4f0e6;
  border-bottom: 2rpx solid #e8e1cf;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-icon {
  font-size: 48rpx;
  color: var(--color-text);
  font-weight: 300;
  line-height: 1;
}

.header-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #362f2d;
}

.coffee-icon {
  color: #6b8e5c;
}

.header-spacer {
  width: 80rpx;
}

/* ===== Container ===== */
.container {
  height: 100vh;
  padding: 32rpx var(--padding-page);
  box-sizing: border-box;
}

.bottom-spacer {
  height: 120rpx;
}

/* ===== Topic Section ===== */
.topic-section {
  margin-bottom: 32rpx;
}

.topic-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.topic-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.change-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  border-radius: var(--radius-full);
  background-color: #fdfbf6;
  border: 2rpx solid #e8e1cf;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.change-btn:active {
  opacity: 0.7;
}

.change-icon {
  font-size: 28rpx;
  color: #d48c6a;
}

.change-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #b85b3d;
}

.topic-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #f4f0e6 0%, #fdfbf6 100%);
  border: 4rpx solid #d2decb;
  border-radius: 64rpx;
  padding: 64rpx;
  min-height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.topic-blur-circle {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 256rpx;
  height: 256rpx;
  background-color: #eef1eb;
  border-radius: 50%;
  filter: blur(50rpx);
  opacity: 0.6;
}

.quote-mark {
  position: absolute;
  font-size: 120rpx;
  color: #d2decb;
  font-family: Georgia, 'Times New Roman', serif;
  opacity: 0.4;
  line-height: 1;
}

.quote-open {
  top: 32rpx;
  left: 32rpx;
}

.quote-close {
  bottom: 24rpx;
  right: 32rpx;
}

.topic-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #362f2d;
  text-align: center;
  position: relative;
  z-index: 1;
  line-height: 1.5;
}

/* ===== Options Card ===== */
.options-card {
  background-color: #fdfbf6;
  padding: 40rpx;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  border: 2rpx solid #e8e1cf;
  margin-bottom: 32rpx;
}

.option-group {
  margin-bottom: 36rpx;
}

.option-group:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 24rpx;
  display: block;
}

.age-row {
  display: flex;
  gap: 20rpx;
}

.narrator-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.chip {
  position: relative;
  overflow: hidden;
  flex: 1;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: 2rpx solid var(--color-border);
  background-color: var(--color-bg);
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.chip:active {
  opacity: 0.8;
}

.chip-label {
  position: relative;
  z-index: 1;
}

.chip-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.1);
  z-index: 0;
}

.chip-active-green {
  background-color: #6b8e5c;
  color: #ffffff;
  border-color: #6b8e5c;
  box-shadow: 0 4rpx 16rpx rgba(107, 142, 92, 0.3);
}

.chip-active-primary {
  background-color: #b85b3d;
  color: #ffffff;
  border-color: #b85b3d;
  box-shadow: 0 4rpx 16rpx rgba(184, 91, 61, 0.3);
}

/* ===== Memory Section ===== */
.memory-section {
  margin-bottom: 48rpx;
}

.memory-label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.sparkle-icon {
  font-size: 28rpx;
  color: #d48c6a;
}

.memory-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.memory-hint {
  font-size: 24rpx;
  color: #a39c8f;
  margin-bottom: 16rpx;
  margin-left: 48rpx;
  display: block;
}

.memory-input-wrap {
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background-color: #fdfbf6;
  transition: border-color 0.2s, background-color 0.2s;
}

.memory-input-wrap.recording {
  border-color: #d48c6a;
  background-color: rgba(249, 233, 227, 0.3);
}

.memory-textarea {
  width: 100%;
  height: 180rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.6;
  box-sizing: border-box;
  background-color: transparent;
}

.memory-placeholder {
  color: #c4bfb2;
  font-size: 26rpx;
}

.mic-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 20rpx;
}

.mic-tip {
  font-size: 24rpx;
  color: #a39c8f;
}

.mic-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #eef1eb;
  border: 2rpx solid #d2decb;
  flex-shrink: 0;
}

.mic-btn:active {
  opacity: 0.7;
}

.mic-recording {
  background-color: #d48c6a !important;
  border-color: #d48c6a !important;
  box-shadow: 0 4rpx 16rpx rgba(212, 140, 106, 0.4);
  animation: pulse 1.5s ease-in-out infinite;
}

.mic-icon {
  font-size: 36rpx;
  color: #6b8e5c;
}

.mic-stop-icon {
  font-size: 28rpx;
  color: #ffffff;
}

.recording-indicator {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.recording-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #e74c3c;
  animation: blink 1s ease-in-out infinite;
}

.recording-label {
  font-size: 26rpx;
  color: #d48c6a;
  font-weight: 500;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* ===== Generate Button ===== */
.generate-btn {
  background-color: #b85b3d;
  color: #ffffff;
  font-weight: 700;
  font-size: 36rpx;
  text-align: center;
  padding: 32rpx 0;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(184, 91, 61, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.generate-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.generate-btn.generating {
  opacity: 0.7;
}

.gen-text {
  font-weight: 700;
}

.gen-text.pulse {
  animation: pulse 1.5s ease-in-out infinite;
}

/* ===== Animations ===== */
@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}
