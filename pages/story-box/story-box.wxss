.page {
  min-height: 100vh;
  background-color: #f4f0e6;
}

/* Header */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: rgba(244, 240, 230, 0.92);
  backdrop-filter: blur(20px);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  position: relative;
}

.header-title-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.header-icon {
  font-size: 36rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #362f2d;
}

/* Content */
.container {
  padding: 24rpx 32rpx 200rpx;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
}

.empty-icon-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #fdfbf6;
  border: 2rpx solid #e8e1cf;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-icon {
  font-size: 72rpx;
  color: #a39c8f;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #362f2d;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #7a7267;
  text-align: center;
  line-height: 1.7;
  max-width: 480rpx;
  margin-bottom: 64rpx;
}

.empty-btn {
  background-color: #b85b3d;
  color: #fff;
  padding: 24rpx 48rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 28rpx rgba(184, 91, 61, 0.25);
}

.empty-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* Card List */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.card-item {
  background-color: #fdfbf6;
  border-radius: 32rpx;
  border: 2rpx solid #e8e1cf;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  transition: transform 0.15s;
}

.card-item:active {
  transform: scale(0.98);
}

.card-top-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card-scene {
  display: inline-block;
  padding: 4rpx 16rpx;
  background-color: #f4f0e6;
  color: #7a7267;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
  border: 2rpx solid #e8e1cf;
  align-self: flex-start;
  margin-bottom: 4rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #362f2d;
  line-height: 1.4;
  padding-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-date-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.card-date-icon {
  font-size: 22rpx;
  color: #a39c8f;
}

.card-date {
  font-size: 24rpx;
  color: #a39c8f;
}

.card-delete-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f4f0e6;
  border-radius: 50%;
}

.card-delete-btn:active {
  opacity: 0.5;
}

.delete-icon {
  font-size: 32rpx;
  color: #a39c8f;
}
