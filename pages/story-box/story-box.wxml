<wxs module="dateUtil">
  module.exports.format = function(ts) {
    if (!ts) return '';
    var d = getDate(ts);
    var m = d.getMonth() + 1;
    var day = d.getDate();
    return m + '月' + day + '日';
  }
</wxs>

<view class="page">
  <!-- Header -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-inner">
      <view class="header-title-wrap">
        <text class="header-icon">📚</text>
        <text class="header-title">我的故事盒子</text>
      </view>
    </view>
  </view>

  <view class="container" style="padding-top: {{statusBarHeight + 56}}px;">
    <!-- Empty State -->
    <view class="empty-state" wx:if="{{savedCards.length === 0}}">
      <view class="empty-icon-circle">
        <text class="empty-icon">📚</text>
      </view>
      <text class="empty-title">盒子还是空的</text>
      <text class="empty-desc">把喜欢的亲子陪伴脚本收藏到这里，随时可以拿出来用。</text>
      <view class="empty-btn" bindtap="handleGoCreate">
        <text>去准备今晚的话题</text>
      </view>
    </view>

    <!-- Card List -->
    <view class="card-list" wx:else>
      <view
        class="card-item"
        wx:for="{{savedCards}}"
        wx:key="id"
        bindtap="handleOpenCard"
        data-id="{{item.id}}"
      >
        <view class="card-top-row">
          <view class="card-body">
            <text class="card-scene" wx:if="{{item.scene}}">{{item.scene}}</text>
            <text class="card-title">{{item.title}}</text>
          </view>
          <view
            class="card-delete-btn"
            catchtap="handleRemoveCard"
            data-id="{{item.id}}"
          >
            <text class="delete-icon">🗑️</text>
          </view>
        </view>
        <view class="card-date-row">
          <text class="card-date-icon">⏰</text>
          <text class="card-date">{{dateUtil.format(item.createdAt)}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
