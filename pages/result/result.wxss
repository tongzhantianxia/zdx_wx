.page {
  min-height: 100vh;
  background-color: #f4f0e6;
}

/* ── Floating header ── */
.float-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  height: 88rpx;
}

.back-btn {
  padding: 16rpx;
  color: #362f2d;
  background: rgba(244, 240, 230, 0.8);
  backdrop-filter: blur(12px);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn:active {
  transform: scale(0.92);
}

.back-icon {
  font-size: 36rpx;
}

.header-right {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 16rpx;
  color: #362f2d;
  background: rgba(253, 251, 246, 0.8);
  backdrop-filter: blur(12px);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid #e8e1cf;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.saved,
.action-btn.copied {
  color: #6b8e5c;
}

.action-btn:active {
  transform: scale(0.92);
}

.action-icon {
  font-size: 36rpx;
}

/* ── Container ── */
.container {
  padding: 24rpx 32rpx 60rpx;
}

/* ── Result card ── */
.result-card {
  background: #fdfbf6;
  border-radius: 64rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid #e8e1cf;
  overflow: hidden;
  position: relative;
}

.notebook-binding {
  position: absolute;
  left: 32rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  border-left: 4rpx dashed rgba(232, 225, 207, 0.5);
}

/* ── Card header ── */
.card-header {
  background: #b85b3d;
  padding: 48rpx 40rpx;
  color: #fff;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.scene-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
  backdrop-filter: blur(8px);
}

.card-title {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.4;
}

/* ── Card body ── */
.card-body {
  padding: 48rpx 48rpx 48rpx 64rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section:last-child {
  margin-bottom: 0;
}

/* Section labels */
.section-label {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.label-primary {
  color: #b85b3d;
}

.label-dark {
  color: #362f2d;
}

/* Opening block */
.opening-block {
  background: #f4f0e6;
  padding: 32rpx;
  border-radius: 32rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #362f2d;
  border: 2rpx solid #e8e1cf;
}

/* Story text */
.story-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: #362f2d;
}

/* Divider */
.divider {
  height: 2rpx;
  background: #e8e1cf;
}

/* Questions */
.question-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.question-item {
  display: flex;
  gap: 16rpx;
  font-size: 30rpx;
}

.question-num {
  color: #b85b3d;
  font-weight: 700;
  flex-shrink: 0;
}

.question-text {
  color: #362f2d;
  line-height: 1.7;
  flex: 1;
}

/* Response block */
.response-block {
  background: #fcf0e8;
  padding: 32rpx;
  border-radius: 32rpx;
  border: 2rpx solid #eebd9c;
}

.response-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #362f2d;
}

/* Tips section */
.tips-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tip-card {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 32rpx;
}

.remind-card {
  background: #fdfbf6;
  border: 2rpx solid #e8e1cf;
}

.action-card {
  background: #eef1eb;
  border: 2rpx solid #d2decb;
}

.tip-emoji {
  font-size: 36rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.tip-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 700;
}

.tip-title-dark {
  color: #362f2d;
}

.tip-title-green {
  color: #6b8e5c;
}

.tip-desc {
  line-height: 1.6;
}

.tip-desc-muted {
  color: #7a7267;
  font-size: 24rpx;
}

.tip-desc-green {
  color: #4b6640;
  font-size: 28rpx;
}

/* ── Bottom actions ── */
.bottom-actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  padding-bottom: 60rpx;
}

.btn-regen {
  flex: 1;
  background: #fdfbf6;
  border: 2rpx solid #e8e1cf;
  color: #362f2d;
  padding: 28rpx 0;
  border-radius: 24rpx;
  font-weight: 700;
  font-size: 28rpx;
  text-align: center;
}

.btn-regen:active {
  background: #f4f0e6;
  transform: scale(0.98);
}

.btn-collect {
  flex: 1;
  background: #362f2d;
  color: #fdfbf6;
  padding: 28rpx 0;
  border-radius: 24rpx;
  font-weight: 700;
  font-size: 28rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(54, 47, 45, 0.2);
}

.btn-collect.collected {
  opacity: 0.8;
}

.btn-collect:active {
  opacity: 0.9;
  transform: scale(0.98);
}
