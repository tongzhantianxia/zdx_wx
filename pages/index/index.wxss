.page {
  padding: 0 var(--padding-page);
  padding-bottom: 200rpx;
  min-height: 100vh;
}

/* Header */
.header {
  padding: 48rpx 0 32rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: #362f2d;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: #7a7267;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.header-clock {
  font-size: 28rpx;
}

/* Card Grid */
.card-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.entry-card {
  background-color: var(--color-card);
  border-radius: 32rpx;
  border: 2rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
  padding: 32rpx;
  box-sizing: border-box;
  transition: transform 0.15s ease;
}

.entry-card:active {
  transform: scale(0.97);
}

/* Full-width cards: horizontal flex row with gap */
.card-full {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

/* Half-width cards container */
.card-row-half {
  display: flex;
  gap: 24rpx;
}

.card-half {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* Icon areas */
.card-icon-area {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 32rpx;
}

.card-full .card-icon-area {
  width: 96rpx;
  height: 96rpx;
  padding: 24rpx;
}

.card-half .card-icon-area {
  width: 80rpx;
  height: 80rpx;
  padding: 20rpx;
}

.icon-green {
  background-color: #eef1eb;
}

.icon-orange {
  background-color: #fcf0e8;
}

.icon-brown {
  background-color: #f2ebdf;
}

.icon-blue {
  background-color: #e8f0f3;
}

.card-emoji {
  font-size: 40rpx;
}

.card-content {
  flex: 1;
}

/* Title variants matching React exactly */
.card-title-lg {
  font-size: 34rpx;
  font-weight: 700;
  color: #362f2d;
}

.card-title-sm {
  font-weight: 700;
  color: #362f2d;
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.card-title-homework {
  font-weight: 700;
  color: #362f2d;
  font-size: 28rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #7a7267;
  margin-top: 6rpx;
}

.card-desc-xs {
  font-size: 24rpx;
  color: #7a7267;
}

.card-desc-homework {
  font-size: 24rpx;
  color: #7a7267;
  margin-top: 4rpx;
}

.card-half-text {
  display: flex;
  flex-direction: column;
}

/* Homework card layout: justify-between */
.card-homework {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-homework-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.badge {
  background-color: #b85b3d;
  color: #fff;
  font-size: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(184, 91, 61, 0.15);
  flex-shrink: 0;
}

/* Memory Section */
.memory-section {
  margin-top: 48rpx;
}

.memory-section .section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sparkle-icon {
  color: #d48c6a;
  font-size: 32rpx;
}

.memory-btns {
  display: flex;
  gap: 24rpx;
  overflow-x: auto;
  padding-bottom: 16rpx;
  -webkit-overflow-scrolling: touch;
}

.memory-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background-color: var(--color-card);
  border-radius: 32rpx;
  border: 2rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
  transition: transform 0.15s ease;
}

.memory-btn:active {
  transform: scale(0.95);
}

.memory-btn-icon {
  font-size: 32rpx;
  color: #a39c8f;
}

.memory-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #362f2d;
}

/* Bottom Sheet */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.2s ease;
}

.sheet {
  width: 100%;
  background-color: #f4f0e6;
  background-image: linear-gradient(rgba(232, 225, 207, 0.7) 1px, transparent 1px);
  background-size: 100% 80rpx;
  border-radius: 64rpx 64rpx 0 0;
  padding: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.08);
  animation: slideUp 0.25s ease;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  margin-bottom: 16rpx;
  border-bottom: 2rpx solid #e8e1cf;
  background-color: rgba(244, 240, 230, 0.9);
  position: sticky;
  top: 0;
  z-index: 10;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #362f2d;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sheet-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #a39c8f;
  background-color: #fdfbf6;
  border-radius: 50%;
  border: 2rpx solid #e8e1cf;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.sheet-intro {
  font-size: 26rpx;
  color: #7a7267;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.sheet-title-icon {
  font-size: 36rpx;
}

.sheet-scroll {
  flex: 1;
  overflow-y: auto;
  padding-bottom: 32rpx;
}

.sheet-item {
  background-color: #fdfbf6;
  padding: 24rpx;
  border-radius: 32rpx;
  border: 2rpx solid #e8e1cf;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.sheet-item:last-child {
  margin-bottom: 0;
}

.sheet-item-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background-color: #eee;
}

.sheet-item-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 128rpx;
}

.sheet-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.sheet-item-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* Image Preview Overlay */
.preview-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.9);
  z-index: 2000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  animation: fadeIn 0.2s ease;
}

.preview-close {
  position: absolute;
  top: 100rpx;
  right: 40rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 56rpx;
  font-weight: 300;
  z-index: 10;
}

.preview-image {
  width: 100%;
  height: 80vh;
  border-radius: 32rpx;
}

/* Onboarding Full-page Overlay */
/* ===== Onboarding ===== */
.onboarding-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--color-bg);
  z-index: 9999;
  animation: fadeIn 0.3s ease;
}

.onboarding-page {
  display: flex;
  flex-direction: column;
  padding: 160rpx 64rpx 96rpx;
  min-height: 100vh;
  box-sizing: border-box;
  overflow-y: auto;
}

.onboarding-top {
  margin-bottom: 8rpx;
}

.onboarding-title-line1 {
  font-size: 72rpx;
  font-weight: 900;
  color: #362f2d;
  line-height: 1.2;
  letter-spacing: -1rpx;
  margin-bottom: 4rpx;
}

.onboarding-title-line2 {
  font-size: 96rpx;
  font-weight: 900;
  color: #b85b3d;
  line-height: 1.2;
  letter-spacing: -1rpx;
  margin-bottom: 20rpx;
}

.onboarding-subtitle {
  font-size: 30rpx;
  color: #7a7267;
  line-height: 1.6;
  max-width: 560rpx;
}

/* Illustration Card */
.onboarding-illust-card {
  background-color: #fdfbf6;
  border-radius: 48rpx;
  border: 2rpx solid #e8e1cf;
  padding: 48rpx 64rpx;
  margin: 40rpx 0 80rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
  display: flex;
  align-items: center;
  justify-content: center;
}

.illust-scene {
  position: relative;
  width: 400rpx;
  height: 260rpx;
}

.illust-person-lg {
  position: absolute;
  left: 80rpx;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.illust-head-lg {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #e1b896;
  margin-bottom: -12rpx;
  z-index: 1;
}

.illust-body-lg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx 60rpx 12rpx 12rpx;
  background-color: #d8e2d1;
  border: 2rpx solid #c5d1bc;
}

.illust-person-sm {
  position: absolute;
  right: 80rpx;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.illust-head-sm {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: #e1b896;
  margin-bottom: -10rpx;
  z-index: 1;
}

.illust-body-sm {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx 48rpx 10rpx 10rpx;
  background-color: #eedbc0;
  border: 2rpx solid #e0ccaf;
}

.illust-book-line {
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background-color: #b85b3d;
}

/* Check Items */
.onboarding-checks {
  flex: 1;
  padding: 0 8rpx;
}

.onboarding-check-item {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 48rpx;
}

.onboarding-check-item:last-child {
  margin-bottom: 0;
}

.check-icon {
  color: #6b8e5c;
  font-size: 36rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.check-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #362f2d;
}

/* CTA Button */
.onboarding-btn {
  background-color: #b85b3d;
  color: #fff;
  border-radius: 32rpx;
  padding: 32rpx 0;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(184, 91, 61, 0.25);
  margin-top: 96rpx;
  margin-bottom: env(safe-area-inset-bottom);
}

.onboarding-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
