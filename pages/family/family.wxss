.page {
  min-height: 100vh;
  background-color: #f4f0e6;
}

/* Header */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: rgba(244, 240, 230, 0.95);
  backdrop-filter: blur(20px);
  border-bottom: 2rpx solid #e8e1cf;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.back-btn {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.back-arrow {
  font-size: 36rpx;
  color: #362f2d;
  font-weight: 700;
}

.header-title-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.header-icon {
  font-size: 36rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #362f2d;
}

.header-placeholder {
  width: 80rpx;
}

/* Content */
.container {
  padding: 32rpx 32rpx 200rpx;
}

/* Selection Card */
.selection-card {
  background-color: #fdfbf6;
  padding: 40rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid #e8e1cf;
  margin-bottom: 32rpx;
}

.card-section {
  padding: 8rpx 0;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #362f2d;
  margin-bottom: 24rpx;
}

/* Members Grid */
.member-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.member-item {
  padding: 20rpx 0;
  border-radius: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #7a7267;
  background-color: #f4f0e6;
  border: 2rpx solid #e8e1cf;
  transition: all 0.2s;
}

.member-item.selected {
  background-color: #f2ebdf;
  color: #8d7c62;
  border-color: #d6cdbd;
  font-weight: 700;
}

.card-section + .card-section {
  margin-top: 48rpx;
}

/* Experience Tags */
.exp-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.exp-tag {
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #7a7267;
  background-color: #f4f0e6;
  border: 2rpx solid #e8e1cf;
  transition: all 0.15s;
}

.exp-tag.selected {
  background-color: #362f2d;
  color: #fdfbf6;
  border-color: #362f2d;
}

/* Memory Input */
.memory-section {
  margin-bottom: 48rpx;
}

.memory-label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.memory-sparkle {
  font-size: 28rpx;
  color: #d48c6a;
}

.memory-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #362f2d;
}

.memory-hint {
  display: block;
  font-size: 24rpx;
  color: #a39c8f;
  margin-bottom: 16rpx;
  margin-left: 48rpx;
}

.memory-textarea {
  width: 100%;
  height: 192rpx;
  font-size: 28rpx;
  color: #362f2d;
  line-height: 1.6;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: #fdfbf6;
  border: 2rpx solid #e8e1cf;
  border-radius: 24rpx;
}

.memory-placeholder {
  color: #a39c8f;
  font-size: 26rpx;
}

/* Generate Button */
.btn-generate {
  background-color: #8d7c62;
  color: #fff;
  border: none;
  border-radius: 32rpx;
  padding: 28rpx 0;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  width: 100%;
  box-shadow: 0 8rpx 28rpx rgba(141, 124, 98, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-generate:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-generate.disabled {
  opacity: 0.7;
}
