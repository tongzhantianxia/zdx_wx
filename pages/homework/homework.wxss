.page {
  min-height: 100vh;
  background-color: #f4f0e6;
}

/* Header */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: rgba(244, 240, 230, 0.95);
  backdrop-filter: blur(20px);
  border-bottom: 2rpx solid #e8e1cf;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.back-btn {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.back-arrow {
  font-size: 36rpx;
  color: #362f2d;
  font-weight: 700;
}

.header-title-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.header-icon {
  font-size: 36rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #6a8ea3;
}

.header-placeholder {
  width: 80rpx;
}

/* Content */
.container {
  padding: 32rpx 32rpx 200rpx;
}

/* Info Banner */
.info-banner {
  background-color: #e8f0f3;
  border: 2rpx solid #c1d6e0;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
}

.banner-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #43677a;
  line-height: 1.7;
}

/* Task Selection */
.task-section {
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #362f2d;
  margin-bottom: 24rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #7a7267;
  background-color: #fdfbf6;
  border: 2rpx solid #e8e1cf;
  text-align: left;
  transition: all 0.2s;
}

.task-item.selected {
  background-color: #6a8ea3;
  color: #fff;
  border-color: #6a8ea3;
  box-shadow: 0 8rpx 24rpx rgba(106, 142, 163, 0.2);
}

.task-text {
  flex: 1;
}

.task-arrow {
  font-size: 32rpx;
  font-weight: 700;
  margin-left: 16rpx;
}

/* Generate Button */
.btn-area {
  padding-top: 64rpx;
}

.btn-generate {
  background-color: #b85b3d;
  color: #fff;
  border: none;
  border-radius: 32rpx;
  padding: 28rpx 0;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  width: 100%;
  box-shadow: 0 8rpx 28rpx rgba(184, 91, 61, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-generate:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-generate.disabled {
  opacity: 0.7;
}
