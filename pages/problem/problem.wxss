.page {
  min-height: 100vh;
  background-color: #f4f0e6;
}

/* Header */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: rgba(244, 240, 230, 0.95);
  backdrop-filter: blur(20px);
  border-bottom: 2rpx solid #e8e1cf;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.back-btn {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.back-arrow {
  font-size: 36rpx;
  color: #362f2d;
  font-weight: 700;
}

.header-title-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.header-icon {
  font-size: 36rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #362f2d;
}

.header-placeholder {
  width: 80rpx;
}

/* Content */
.container {
  padding: 32rpx 32rpx 160rpx;
}

.section {
  margin-bottom: 64rpx;
}

/* Problem Selection */
.section-label {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #362f2d;
  margin-bottom: 32rpx;
}

.problem-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.problem-item {
  padding: 32rpx 40rpx;
  border-radius: 32rpx;
  text-align: left;
  font-size: 30rpx;
  font-weight: 500;
  color: #7a7267;
  background-color: #fdfbf6;
  border: 4rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  transition: all 0.15s;
}

.problem-item.selected {
  background-color: #fcf0e8;
  color: #b85b3d;
  border-color: #eebd9c;
  box-shadow: 0 4rpx 12rpx rgba(212, 140, 106, 0.1);
}

.problem-item:active {
  opacity: 0.85;
}

/* Tone Selection */
.tone-label {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #362f2d;
  margin-bottom: 24rpx;
}

.tone-row {
  display: flex;
  gap: 16rpx;
}

.tone-chip {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #7a7267;
  background-color: #fdfbf6;
  border: 2rpx solid #e8e1cf;
  transition: all 0.15s;
}

.tone-chip.selected {
  background-color: #362f2d;
  color: #fdfbf6;
  border-color: #362f2d;
  box-shadow: 0 4rpx 16rpx rgba(54, 47, 45, 0.25);
}

/* Generate Button */
.btn-generate {
  background-color: #d48c6a;
  color: #fff;
  border: none;
  border-radius: 32rpx;
  padding: 28rpx 0;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  width: 100%;
  box-shadow: 0 8rpx 28rpx rgba(212, 140, 106, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 48rpx;
}

.btn-generate:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-generate.disabled {
  opacity: 0.7;
}
